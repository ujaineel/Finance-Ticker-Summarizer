{
    "name": "Finance Ticker Summarizer",
    "version": "1.0",
    "description": "Summarizes stock data for companies and tickers mentioned in articles using Yahoo Finance",
    "manifest_version": 3,
    "permissions": [
        "sidePanel",
        "storage"
    ],
    "host_permissions": [
        "https://finance.yahoo.com/*",
        "https://query1.finance.yahoo.com/*",
        "https://query2.finance.yahoo.com/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "side_panel": {
        "default_path": "scripts/sidepanel.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scripts/content.js"
            ]
        }
    ],
    "action": {
        "default_icon": "images/finance_extensions.png"
    }
}